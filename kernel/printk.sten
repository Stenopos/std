/// Stenopos standard library — kernel.printk
/// The kernel's logging primitive and log-level helpers.
///
/// printk is like printf but writes to the kernel ring buffer (read with
/// `dmesg`). Each message carries a log level via a leading prefix; in C that
/// is the KERN_INFO / KERN_ERR macros, which expand to "\001" plus a digit.
/// The pr_* helpers below prepend the right prefix so callers don't have to.
module kernel.printk

// The core kernel logging function (variadic, printf-style format).
extern "C" func printk(str fmt, ...) -> int32

// Log-level prefixes: KERN_SOH ("\x01", start of header) and a digit for the
// level, 0=emerg ... 7=debug (C's KERN_* macros).
pub const str KERN_EMERG = "\x010"     // system is unusable
pub const str KERN_ALERT = "\x011"     // action must be taken immediately
pub const str KERN_CRIT = "\x012"      // critical conditions
pub const str KERN_ERR = "\x013"       // error conditions
pub const str KERN_WARNING = "\x014"   // warning conditions
pub const str KERN_NOTICE = "\x015"    // normal but significant
pub const str KERN_INFO = "\x016"      // informational
pub const str KERN_DEBUG = "\x017"     // debug-level messages

// `msg` at `level`, with a newline. The message is an argument, never the
// format: a `%` in it is printed, not read as a conversion.
func log_at(str level, str msg) -> void {
    unsafe {
        discard printk(level + "%s\n", msg)
    }
}

/// Log `msg` at the informational level.
pub func pr_info(str msg) -> void {
    log_at(KERN_INFO, msg)
}

/// Log `msg` at the notice level (normal but significant).
pub func pr_notice(str msg) -> void {
    log_at(KERN_NOTICE, msg)
}

/// Log `msg` at the warning level.
pub func pr_warn(str msg) -> void {
    log_at(KERN_WARNING, msg)
}

/// Log `msg` at the error level.
pub func pr_err(str msg) -> void {
    log_at(KERN_ERR, msg)
}

/// Log `msg` at the debug level.
pub func pr_debug(str msg) -> void {
    log_at(KERN_DEBUG, msg)
}
