/// Stenopos standard library — kernel.errno
/// Standard Linux error codes, as the NEGATIVE values kernel functions return.
///
/// Kernel functions signal failure by returning `-Exxx` (e.g. a read handler
/// returns -EFAULT if copy_to_user fails). Userspace then sees errno = Exxx.
/// Use these constants instead of magic numbers like `-14`.
module kernel.errno

pub const int32 EPERM = -1    // Operation not permitted
pub const int32 ENOENT = -2    // No such file or directory
pub const int32 ESRCH = -3    // No such process
pub const int32 EINTR = -4    // Interrupted system call
pub const int32 EIO = -5    // I/O error
pub const int32 ENXIO = -6    // No such device or address
pub const int32 E2BIG = -7    // Argument list too long
pub const int32 EBADF = -9    // Bad file number
pub const int32 EAGAIN = -11   // Try again
pub const int32 ENOMEM = -12   // Out of memory
pub const int32 EACCES = -13   // Permission denied
pub const int32 EFAULT = -14   // Bad address (e.g. copy_to_user failed)
pub const int32 EBUSY = -16   // Device or resource busy
pub const int32 EEXIST = -17   // File exists
pub const int32 ENODEV = -19   // No such device
pub const int32 ENOTDIR = -20   // Not a directory
pub const int32 EISDIR = -21   // Is a directory
pub const int32 EINVAL = -22   // Invalid argument
pub const int32 ENFILE = -23   // File table overflow
pub const int32 EMFILE = -24   // Too many open files
pub const int32 ENOSPC = -28   // No space left on device
pub const int32 EROFS = -30   // Read-only file system
pub const int32 EPIPE = -32   // Broken pipe
pub const int32 ERANGE = -34   // Math result not representable
pub const int32 ENOSYS = -38   // Function not implemented
