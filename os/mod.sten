// Stenopos standard library — os module
// Thin, named wrappers over the process/CLI built-ins (exec / arg_count /
// arg), plus small conveniences for reading argv.
//
//   import std.os.{run, argc, arg, args, program_name}
//
// `run` shells out to a command and returns its exit code; the argv helpers
// expose the arguments the program was launched with.

module std.os

// Run a shell command; returns its exit code (127 if it could not be run).
// The command is passed to the system shell, so redirection and pipes work.
@cap(Process)
pub func run(str command) -> int32 {
    return exec(command)
}

// Run a command and return true iff it exited 0 (succeeded).
@cap(Process)
pub func run_ok(str command) -> bool {
    return exec(command) == 0
}

// The number of command-line arguments, including the program name at index 0.
pub func argc() -> int32 {
    return arg_count()
}

// The argument at `index` (0 = the program name). Out-of-range indices return
// an empty string rather than aborting, so callers can probe optional args.
pub func arg_at(int32 index) -> str {
    if (index < 0 || index >= arg_count()) {
        return ""
    }
    return arg(index)
}

// The program name (argv[0]), or "" if somehow unavailable.
pub func program_name() -> str {
    return arg_at(0)
}

// All arguments AFTER the program name, in order, as a List[str]. Empty when
// the program was launched with no extra arguments.
pub func args() -> List[str] {
    List[str] out = list_new()
    int32 n = arg_count()
    int32 i = 1
    while (i < n) {
        out.push(arg(i))
        i = i + 1
    }
    return out
}

// True when the flag `name` (matched exactly) appears among the arguments —
// e.g. `has_flag("--verbose")`.
pub func has_flag(str name) -> bool {
    int32 n = arg_count()
    int32 i = 1
    while (i < n) {
        if (arg(i) == name) {
            return true
        }
        i = i + 1
    }
    return false
}
