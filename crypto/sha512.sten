    t.push(0x243185be_4ee4b28c)
    t.push(0x550c7dc3_d5ffb4e2)
    t.push(0x72be5d74_f27b896f)
    t.push(0x80deb1fe_3b1696b1)
    t.push(0x9bdc06a7_25c71235)
    t.push(0xc19bf174_cf692694)
    t.push(0xe49b69c1_9ef14ad2)
    t.push(0xefbe4786_384f25e3)
    t.push(0x0fc19dc6_8b8cd5b5)
    t.push(0x240ca1cc_77ac9c65)
    t.push(0x2de92c6f_592b0275)
    t.push(0x4a7484aa_6ea6e483)
    t.push(0x5cb0a9dc_bd41fbd4)
    t.push(0x76f988da_831153b5)
    t.push(0x983e5152_ee66dfab)
    t.push(0xa831c66d_2db43210)
    t.push(0xb00327c8_98fb213f)
    t.push(0xbf597fc7_beef0ee4)
    t.push(0xc6e00bf3_3da88fc2)
    t.push(0xd5a79147_930aa725)
    t.push(0x06ca6351_e003826f)
    t.push(0x14292967_0a0e6e70)
    t.push(0x27b70a85_46d22ffc)
    t.push(0x2e1b2138_5c26c926)
    t.push(0x4d2c6dfc_5ac42aed)
    t.push(0x53380d13_9d95b3df)
    t.push(0x650a7354_8baf63de)
    t.push(0x766a0abb_3c77b2a8)
    t.push(0x81c2c92e_47edaee6)
    t.push(0x92722c85_1482353b)
    t.push(0xa2bfe8a1_4cf10364)
    t.push(0xa81a664b_bc423001)
    t.push(0xc24b8b70_d0f89791)
    t.push(0xc76c51a3_0654be30)
    t.push(0xd192e819_d6ef5218)
    t.push(0xd6990624_5565a910)
    t.push(0xf40e3585_5771202a)
    t.push(0x106aa070_32bbd1b8)
    t.push(0x19a4c116_b8d2d0c8)
    t.push(0x1e376c08_5141ab53)
    t.push(0x2748774c_df8eeb99)
    t.push(0x34b0bcb5_e19b48a8)
    t.push(0x391c0cb3_c5c95a63)
