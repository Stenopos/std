func initial_hash() -> List[uint64] {
    List[uint64] t = list_new()
    t.push(0x6a09e667_f3bcc908)
    t.push(0xbb67ae85_84caa73b)
    t.push(0x3c6ef372_fe94f82b)
    t.push(0xa54ff53a_5f1d36f1)
    t.push(0x510e527f_ade682d1)
    t.push(0x9b05688c_2b3e6c1f)
    t.push(0x1f83d9ab_fb41bd6b)
    t.push(0x5be0cd19_137e2179)
    return t
}

func rotr(uint64 x, uint64 n) -> uint64 {
    return (x >> n) | (x << (64 - n))
}

// The message padded to a whole number of 128-byte blocks: a 0x80 byte,
// zeros, then the length in bits as a 128-bit big-endian integer.
func pad(List[int32] msg) -> List[int32] {
    List[int32] out = list_new()
    for (b in msg) {
        out.push(b & 255)
    }
    out.push(128)
    while (out.len() % 128 != 112) {
        out.push(0)
    }
    uint64 nbits = wrapping_mul(cast[uint64](msg.len()), 8)
    int32 z = 0
    while (z < 8) {
        out.push(0)
        z = z + 1
    }
    int32 sh = 56
    while (sh >= 0) {
        out.push(cast[int32]((nbits >> cast[uint64](sh)) & 255))
        sh = sh - 8
    }
    return out
}

// Word `j` of the padded message, big-endian.
func word_at(List[int32] p, int64 j) -> uint64 {
    uint64 w = 0
    int64 k = 0
    while (k < 8) {
        w = (w << 8) | cast[uint64](p.get(j * 8 + k))
        k = k + 1
    }
    return w
}

// The SHA512 digest of `msg`: 16 bytes.
pub func sha512(List[int32] msg) -> List[int32] {
    List[uint64] kk = round_constants()
    List[uint64] h = initial_hash()
    List[int32] p = pad(msg)
    int64 nblocks = p.len() / 128
    int64 blk = 0
    while (blk < nblocks) {
        List[uint64] w = list_new()
        int64 t = 0
        while (t < 16) {
            w.push(word_at(p, blk * 16 + t))
            t = t + 1
        }
        while (t < 80) {
            uint64 w15 = w.get(t - 15)
            uint64 w2 = w.get(t - 2)
            uint64 sg0 = rotr(w15, 1) ^ rotr(w15, 8) ^ (w15 >> 7)
            uint64 sg1 = rotr(w2, 19) ^ rotr(w2, 61) ^ (w2 >> 6)
            w.push(wrapping_add(wrapping_add(sg1, w.get(t - 7)), wrapping_add(sg0, w.get(t - 16))))
            t = t + 1
        }
        uint64 a = h.get(0)
        uint64 b = h.get(1)
        uint64 c = h.get(2)
        uint64 d = h.get(3)
        uint64 e = h.get(4)
        uint64 f = h.get(5)
        uint64 g = h.get(6)
        uint64 hh = h.get(7)
        t = 0
        while (t < 80) {
            uint64 bs1 = rotr(e, 14) ^ rotr(e, 18) ^ rotr(e, 41)
            uint64 ch = (e & f) ^ (~e & g)
            uint64 t1 = wrapping_add(wrapping_add(wrapping_add(hh, bs1), wrapping_add(ch, kk.get(t))), w.get(t))
            uint64 bs0 = rotr(a, 28) ^ rotr(a, 34) ^ rotr(a, 39)
            uint64 maj = (a & b) ^ (a & c) ^ (b & c)
            uint64 t2 = wrapping_add(bs0, maj)
            hh = g
            g = f
            f = e
            e = wrapping_add(d, t1)
            d = c
            c = b
            b = a
            a = wrapping_add(t1, t2)
            t = t + 1
        }
        h.set(0, wrapping_add(h.get(0), a))
        h.set(1, wrapping_add(h.get(1), b))
        h.set(2, wrapping_add(h.get(2), c))
        h.set(3, wrapping_add(h.get(3), d))
        h.set(4, wrapping_add(h.get(4), e))
        h.set(5, wrapping_add(h.get(5), f))
        h.set(6, wrapping_add(h.get(6), g))
        h.set(7, wrapping_add(h.get(7), hh))
        blk = blk + 1
    }
    List[int32] out = list_new()
    for (v in h) {
        int32 sh = 56
        while (sh >= 0) {
            out.push(cast[int32]((v >> cast[uint64](sh)) & 255))
            sh = sh - 8
        }
    }
    return out
}

// The digest of a string's bytes.
pub func sha512_str(str s) -> List[int32] {
    List[int32] b = list_new()
    int64 i = 0
    while (i < s.len()) {
        b.push(s.byte_at(i))
        i = i + 1
    }
    return sha512(b)
}
