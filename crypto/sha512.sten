    t.push(0x84c87814_a1f0ab72)
    t.push(0x8cc70208_1a6439ec)
    t.push(0x90befffa_23631e28)
    t.push(0xa4506ceb_de82bde9)
    t.push(0xbef9a3f7_b2c67915)
