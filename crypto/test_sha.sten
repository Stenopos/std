// Tests for std.crypto.sha256 and std.crypto.sha512. Expected digests come
// from an independent implementation (Python's hashlib), for messages on both
// sides of every padding boundary; the "abc" vectors are FIPS 180-4's.

module std.crypto.sha_tests

import std.crypto.sha256.{sha256, sha256_str}
import std.crypto.sha512.{sha512, sha512_str}
import std.hex.{hex_encode}

func expect_hex(List[int32] got, str want, str name) -> int32 {
    str g = hex_encode(got)
    if (g == want) {
        println("  ok   {name}")
        return 0
    }
    println("  FAIL {name}: got {g}")
    return 1
}

// The test message of `n` bytes: byte i is (i * 31 + 7) % 256.
func msg(int32 n) -> List[int32] {
    List[int32] b = list_new()
    int32 i = 0
    while (i < n) {
        b.push((i * 31 + 7) % 256)
        i = i + 1
    }
    return b
}

func main() -> void {
    int32 fails = 0
    println("std.crypto sha tests:")
    fails += expect_hex(sha256_str("abc"), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad", "sha256 abc (FIPS 180-4)")
    fails += expect_hex(sha512_str("abc"), "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f", "sha512 abc (FIPS 180-4)")
    fails += expect_hex(sha256(msg(0)), "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "sha256 0 bytes")
    fails += expect_hex(sha512(msg(0)), "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e", "sha512 0 bytes")
    fails += expect_hex(sha256(msg(1)), "ca358758f6d27e6cf45272937977a748fd88391db679ceda7dc7bf1f005ee879", "sha256 1 bytes")
    fails += expect_hex(sha512(msg(1)), "365d11a1dfe610b60efa996136d37ab8afd2715b8c6bc2850dc5e6005b702bb9f59b0f306ecb2c43ee44c429967d45843524eb2f7c16aab9bde142ee268b51c6", "sha512 1 bytes")
    fails += expect_hex(sha256(msg(3)), "647674a296197442f518bcca323ec605dd8d098b2d4f22ee1fdcdd2bb753a189", "sha256 3 bytes")
    fails += expect_hex(sha512(msg(3)), "a4fb160ae2ee41d19cbec56b514cc5fb0c07adb0a398968a15857c9ef56ba3813d640099a21cd216a543d7e3feb42493cdf5f5787ec7c0f0a853bcb245f8f243", "sha512 3 bytes")
    fails += expect_hex(sha256(msg(55)), "8aa994584139d128848eeebc4e815639ba5ab6e6e39574195a63ac4f14f7c43b", "sha256 55 bytes")
    fails += expect_hex(sha512(msg(55)), "330eb5e81b4d722cae1e0efbf883efb180c3e346d2b3b797dafc90409583ed35af65dc2d7974a353f0c21663e196b60d3ee5a2c70c50b7b3bccdb93a5dbce6bf", "sha512 55 bytes")
    fails += expect_hex(sha256(msg(56)), "ad574708f75c044c9b85de64cb568ee7711ff4f36448c6242f053ba8f6cc2b63", "sha256 56 bytes")
    fails += expect_hex(sha512(msg(56)), "1b5b63bfd5420b2dc480abce3dbdb3e19e5f9d4fabffba7764883937eaae878a55362c938c141712c44c3076c3fabb2c60814c2994c311c33049a8d6de2a8898", "sha512 56 bytes")
    fails += expect_hex(sha256(msg(57)), "5b46e502092be01b1100193e089fdda95638c12e19a1d24f308eb2c3d3ae849d", "sha256 57 bytes")
    fails += expect_hex(sha512(msg(57)), "909cad7c59ce1bf85c5f52fa6ad3104cddccce5e380453f124c6a3c570c421dc6a6160c4d42abb0cf71f735bd81cbbe08355b400961361f5050f3fab673aa418", "sha512 57 bytes")
    fails += expect_hex(sha256(msg(63)), "280ed3e8ff1df845b2e7dfe6ac6cee817bef20e783cc65abc41b818b4d2fe076", "sha256 63 bytes")
    fails += expect_hex(sha512(msg(63)), "b16f76c30db64b5ee1ef166d2d37e13ff6cee9fd88bae9ba283cd58e0a2133b220a76db56279406461f84ce2cffd1d116d38fd9f38fc5df18770a987ff695499", "sha512 63 bytes")
    fails += expect_hex(sha256(msg(64)), "c6ab9724ade5b6a7a1edfffb12f3aa9181351355af8fd08c919952ad211339dd", "sha256 64 bytes")
    fails += expect_hex(sha512(msg(64)), "4c7aba3659929c4fd87604c532a3b5f174d0626b2d661dbbbfac76c97a49a5a7789d2c68324c754f66bf629fa72054f334feaad8b1cf4c885ae03a1e634afc18", "sha512 64 bytes")
    fails += expect_hex(sha256(msg(65)), "788367c73c7ddf4c53f65e68cc0d943e6227ab55b0e78ba63ace822b1c6301c0", "sha256 65 bytes")
    fails += expect_hex(sha512(msg(65)), "31ad8ce60482e91ec7f83455c280f2dbb4940a400795ae90815bc86891210ebe07b51995eb2d123d6a55a79a998e20cc07716aea7848f6c955b4a4bf14ad0b0a", "sha512 65 bytes")
    fails += expect_hex(sha256(msg(111)), "dd1413178fb627f9abbc041ffe39c44aa7aaa0e2e6d2ca5c4528ac7073a2da45", "sha256 111 bytes")
    fails += expect_hex(sha512(msg(111)), "da780d8338a8a920ceb6892cb4ecbb0cc0c66956269aadd5dd0f48790a00857bd975890f3b2955a317738cc7a770820c29f922ffbc22020f1909d594cc987d1b", "sha512 111 bytes")
    fails += expect_hex(sha256(msg(112)), "a65c92dac124062d0ab951a42773cb04fc98d1d4bf8897b176f8cff3509d379e", "sha256 112 bytes")
    fails += expect_hex(sha512(msg(112)), "053182f7fa4e59f8636e415a77ed4fdc650f0a43834c9d35adf899599c3ab9c4153f02ff50bd01888060cd36a6fa12d9db242fc35164c80135613514186d5843", "sha512 112 bytes")
    fails += expect_hex(sha256(msg(113)), "6f184b6619128e865ecb2b3ea96c03d461f0664d87689480988dbee53a449161", "sha256 113 bytes")
    fails += expect_hex(sha512(msg(113)), "766fea2f90094ecec1166ea4d6e9ddc6ae6fbe4a060e049300ecbe631a7d6547409b6ac39865409e6dd5dada112955fddf32698feb98806c1910f446ac5af7e3", "sha512 113 bytes")
    fails += expect_hex(sha256(msg(127)), "192409cd280e14b743642ad1343fbd3e82d9305de72c078117745a679210cc3d", "sha256 127 bytes")
    fails += expect_hex(sha512(msg(127)), "a7a75593826fd37d4e60f6101eabb9f8ab1cf4d5319ebc805266d5da8deb5097de1a235fc5d9d3d73c50ac100ffc75089fb454674ab61232091bd19cbdc67396", "sha512 127 bytes")
    fails += expect_hex(sha256(msg(128)), "cc548ca2dec1f6fe4f58b2e27aa9c7521607df1130d140b55a4dad0665302356", "sha256 128 bytes")
    fails += expect_hex(sha512(msg(128)), "df007a08f3aaae47e0c92ef840ecd43645ae6098c819f2a4a66174ef1cd49e5c6dfccf0616895e570b7564af641de5863dff9f89c752913d30cf0ecf678e1635", "sha512 128 bytes")
    fails += expect_hex(sha256(msg(129)), "81e89a7b2911aaa7795f9e3d4910cb47d6cd2b00d83b8399481527261a1a7519", "sha256 129 bytes")
    fails += expect_hex(sha512(msg(129)), "a10ea769b79831bca33e9efb29fc501ded6e9c88885d079acb76eecaa8ac58d68bdc7e00103053e1519352c0d064c87accc3d553a6039decc2c4f1e7667eef79", "sha512 129 bytes")
    fails += expect_hex(sha256(msg(200)), "44cae5223d431caed4a9e32271d6abf17c3f2f4abac45fcdb48a99fcc6072a09", "sha256 200 bytes")
    fails += expect_hex(sha512(msg(200)), "5d625ba6509497bd2ca98040de4ae84cdf2ecd52a5340287d3ca2e4fb1eeb5435ad15f7775f714e2ae44173e6a8838902c223d223bf324cdd01c93626d9de5ae", "sha512 200 bytes")
    fails += expect_hex(sha256(msg(1000)), "5097e7d587352f5097062ae679f37bda5802d9f875aba14c8cb4d1a188ada179", "sha256 1000 bytes")
    fails += expect_hex(sha512(msg(1000)), "b41d42e106eca6bf57123566b7ed1550c37d33af23afbfa8e302dfd44c988b3003a26b4140ef42f535e66ea424e7c4a31616307269e6d520a6508f726da23d0a", "sha512 1000 bytes")
    if (fails > 0) {
        fail("FAIL: {fails} check(s) failed")
    }
    println("PASS: all std.crypto sha checks passed")
}
