// Stenopos standard library — tls module (k8s-todo item 6)
//
// TLS client connections, with certificate pinning. Uses the system's
// OpenSSL (3.x or 1.1), loaded the first time a program connects: install
// libssl3 (Debian: `apt-get install libssl3`; it comes with ca-certificates).
// Every function declares @cap(Network).
//
//   TlsConn c = connect("gitea.tuxsmash.com", 443, verified())   // CAs + name
//   TlsConn u = connect("10.0.0.1", 443, pinned("5f:3a:..."))     // a self-signed
//   discard send(c, "GET / HTTP/1.1\r\nHost: ...\r\n\r\n")       //   console
//   str? got = recv_timeout(c, 5000)
//   close(c)
//
// The checks happen after the handshake and before anything is sent:
// `verify` checks the certificate chain (against the system's CAs, or
// `ca_file`) and that it names the host; `pin_sha256` checks the SHA-256 of
// the server's certificate (as `openssl x509 -noout -fingerprint -sha256`
// prints it; colons optional). Either failing closes the connection and
// throws, saying why. TLS 1.2 or newer; SNI is sent for names.
module std.tls

// How to check the server.
pub struct TlsOptions {
    pub bool verify           // check the chain and the host name
    pub str ca_file           // trusted CAs (PEM); "" = the system's
    pub str pin_sha256        // the certificate's SHA-256; "" = no pin
}

// A TLS connection.
pub struct TlsConn {
    pub int32 id
}

// The usual check: the system's CAs, and the certificate must name the host.
pub func verified() -> TlsOptions {
    return TlsOptions { verify: true, ca_file: "", pin_sha256: "" }
}

// Trust exactly the certificate with this SHA-256, as for a device with a
// self-signed certificate: no chain or name check.
pub func pinned(str sha256) -> TlsOptions {
    return TlsOptions { verify: false, ca_file: "", pin_sha256: sha256 }
}

func target(str host, int32 port) -> str {
    if (host.index_of(":") >= 0) {
        return "[" + host + "]:{port}"
    }
    return host + ":{port}"
}

@cap(Network)
func open(str host, int32 port, TlsOptions opts, int32 ms) -> TlsConn {
    int32 v = 0
    if (opts.verify) {
        v = 1
    }
    if (!opts.verify && opts.pin_sha256 == "") {
        throw("tls " + target(host, port) + ": neither verify nor a pin: nothing would be checked (use verified() or pinned(...))")
    }
    int32 id = tls_connect(host, port, opts.pin_sha256, opts.ca_file, v, ms)
    if (id < 0) {
        throw("tls " + target(host, port) + ": " + net_error())
    }
    return TlsConn { id: id }
}

// Connect to `host`:`port` and complete the handshake, checking the server
// as `opts` says. Throws on failure, saying why.
@cap(Network)
pub func connect(str host, int32 port, TlsOptions opts) -> TlsConn {
    return open(host, port, opts, 0)
}

// connect, giving up after `ms` milliseconds (connection and handshake).
@cap(Network)
pub func connect_timeout(str host, int32 port, TlsOptions opts, int32 ms) -> TlsConn {
    return open(host, port, opts, ms)
}

// Write all of `data`. Returns its length. Throws on failure.
@cap(Network)
pub func send(TlsConn c, str data) -> int32 {
    int32 n = tls_write(c.id, data)
    if (n < 0) {
        throw("tls send: " + net_error())
    }
    return n
}

// Read what has arrived (up to 64 KiB), waiting for it. "" when the server
// has closed the connection. Throws on failure.
@cap(Network)
pub func recv(TlsConn c) -> str {
    str got = tls_read(c.id, 0 - 1)
    if (got == "") {
        str why = net_error()
        if (why != "") {
            throw("tls recv: " + why)
        }
    }
    return got
}

// recv, waiting at most `ms` milliseconds: null when nothing arrived in
// time, "" when the server closed the connection.
@cap(Network)
pub func recv_timeout(TlsConn c, int32 ms) -> str? {
    str got = tls_read(c.id, ms)
    if (got == "") {
        str why = net_error()
        if (why == "timed out") {
            return null
        }
        if (why != "") {
            throw("tls recv: " + why)
        }
    }
    return got
}

// Close the connection (telling the server first).
@cap(Network)
pub func close(TlsConn c) -> void {
    discard tls_close(c.id)
}
