// Tests for std.testing — run with:
//   stenopos-cli run std/testing/test_testing.sten
// The framework tests itself: each helper must return 0 on a passing check
// and 1 on a failing one. We verify the RETURN VALUES (the printed lines for
// the intentionally-failing cases are expected noise).

module std.testing.tests

import std.testing.{expect, expect_eq_int, expect_eq_str, expect_true, expect_false, report}

func main() -> int32 {
    int32 fails = 0

    // expect returns 0 when the condition holds, 1 when it does not.
    fails += expect(expect(true, "  (inner: should pass)") == 0, "expect true -> 0")
    fails += expect(expect(false, "  (inner: should fail)") == 1, "expect false -> 1")

    // expect_eq_int.
    fails += expect(expect_eq_int(6, 6, "  (inner: 6==6)") == 0, "eq_int match -> 0")
    fails += expect(expect_eq_int(6, 7, "  (inner: 6!=7)") == 1, "eq_int mismatch -> 1")

    // expect_eq_str.
    fails += expect(expect_eq_str("ok", "ok", "  (inner: ok==ok)") == 0, "eq_str match -> 0")
    fails += expect(expect_eq_str("a", "b", "  (inner: a!=b)") == 1, "eq_str mismatch -> 1")

    // expect_true / expect_false.
    fails += expect(expect_true(1 < 2, "  (inner: 1<2)") == 0, "expect_true -> 0")
    fails += expect(expect_false(1 > 2, "  (inner: !(1>2))") == 0, "expect_false -> 0")

    // report echoes its failure count.
    fails += expect(report(0) == 0, "report(0) -> 0")

    return report(fails)
}
